# PostgreSQL Connection Settings
# Copy this file to .env and update with your actual values

# For PostgreSQL on host machine (Docker Desktop)
POSTGRES_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=smarttodo;Username=YOUR_USER;Password=YOUR_PASSWORD

# For PostgreSQL in another Docker container (update YOUR_POSTGRES_CONTAINER_NAME)
# POSTGRES_CONNECTION_STRING=Host=YOUR_POSTGRES_CONTAINER_NAME;Port=5432;Database=smarttodo;Username=stododev;Password=P@ssw0rd

# For PostgreSQL on Linux host using host network mode
# POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=smarttodo;Username=YOUR_USER;Password=YOUR_PASSWORD
